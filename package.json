{
  "name": "bright-bloom-shinagawa-myno-booking",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run build && node --test tests/production.test.mjs",
    "smoke": "node scripts/smoke-deployment.mjs",
    "lint": "eslint . --ignore-pattern .next --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "guardrails": "node scripts/guardrails.mjs",
    "audit": "npm audit --audit-level=moderate",
    "signatures": "npm audit signatures",
    "sbom": "node scripts/generate-sbom.mjs",
    "release:evidence": "node scripts/create-release-evidence.mjs",
    "check": "npm run guardrails && npm run lint && npm run typecheck && npm test && npm run audit && npm run signatures"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.2.0",
    "globals": "16.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "type": "module"
}
